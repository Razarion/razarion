<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.btxtech</groupId>
    <artifactId>razarion</artifactId>
    <packaging>pom</packaging>
    <version>1.0-SNAPSHOT</version>
    <name>Razarion parent</name>

    <properties>
        <gwt.version>2.12.2</gwt.version>
        <gwt.elemental2.version>1.2.3</gwt.elemental2.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <org.jboss.resteasy.version>6.2.10.Final</org.jboss.resteasy.version>
        <com.google.dagger.version>2.55</com.google.dagger.version>
        <org.dominokit.version>1.0.2</org.dominokit.version>
    </properties>

    <!--
        TeaVM. Nothing after 0.15.0 is on Maven Central; the 0.16.0-dev-* builds live only on the
        project's own host, and the client and worker modules are pinned to 0.16.0-dev-4.
        docs/architecture/teavm-016-evaluation.md has the measurement behind that choice.

        Note what this is, because it is easy to stop seeing: an unsigned artifact from a
        third-party host, in the resolution path of a production build. It stays until 0.16.0 is
        released, and then this block goes.

        Scoped to releases only. A snapshot from here would change under the build without the
        version changing, and a compiler that changes silently is the one thing this must not be.
    -->
    <repositories>
        <repository>
            <id>teavm-dev</id>
            <url>https://teavm.org/maven/repository</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>teavm-dev</id>
            <url>https://teavm.org/maven/repository</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

    <modules>
        <module>razarion-share</module>
        <module>razarion-test-share</module>
        <module>razarion-frontend</module>
        <module>razarion-client-worker-teavm</module>
        <module>razarion-ui-service</module>
        <module>razarion-client-teavm</module>
        <module>razarion-server</module>
    </modules>

    <profiles>
        <profile>
            <id>e2e</id>
            <modules>
                <module>razarion-e2e-test</module>
            </modules>
        </profile>
    </profiles>

    <build>
        <plugins>
        </plugins>
    </build>

</project>
