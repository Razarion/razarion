# Copy to .env and fill in. .env and .tokens.json are gitignored - never commit either.

# --- YouTube (Google Cloud project, OAuth client type "Desktop app") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_PORT=8723

# --- X (developer.x.com, OAuth 2.0, confidential client) ---
X_CLIENT_ID=
X_CLIENT_SECRET=
# X_REDIRECT_PORT=8724

# App-only bearer token, used by backfill/ to READ the timeline. The OAuth client above can only
# post; reading needs this. Requires a project with read access and billing enabled - reads are
# billed per post returned (about $0.005 each).
X_BEARER_TOKEN=

# --- TikTok (developers.tiktok.com) ---
# TikTok refuses http://localhost as a redirect URI. Register an https URL you control, put it
# here, and authorise with --manual (you paste the redirect URL back into the terminal).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://www.razarion.com/oauth/tiktok

# --- Instagram (Meta app, Instagram Business account) ---
# Long-lived user token from the Meta dashboard; expires after 60 days.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_API_VERSION=v25.0
# graph.instagram.com for an Instagram-Login token, graph.facebook.com for a Facebook-Login one.
# INSTAGRAM_API_HOST=graph.instagram.com

# --- Media hosting for backfill/ ---
# Instagram fetches media from a URL instead of accepting an upload, so the files need a public
# home. "github" hangs them off a release (no card, nothing in the git history); "r2" uses the
# Cloudflare bucket configured below.
# MEDIA_STORAGE=github

# Fine-grained personal access token with "Contents: read and write" on the repository below.
GITHUB_TOKEN=
# GITHUB_REPO=Razarion/razarion
# GITHUB_RELEASE_TAG=instagram-media

# --- Cloudflare R2 (alternative to the GitHub release) ---
# Instagram fetches media from a URL instead of accepting an upload, so the files need a public
# home. The bucket must serve objects publicly: enable the r2.dev subdomain or attach a custom
# domain, and put whichever one it is in R2_PUBLIC_BASE_URL.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
# R2_PREFIX=x-backfill

# --- Facebook Page (backfill/ only) ---
# App id and secret from the Meta dashboard: App-Einstellungen -> Grundlegendes.
# Short-lived user token from the Graph API Explorer, with pages_show_list, pages_manage_posts and
# pages_read_engagement. fb_token.mjs trades it for a Page token that does not expire and writes
# that to state/ - after which this line can be emptied again.
FB_USER_TOKEN=
# Only needed if the account administers more than one Page.
# FB_PAGE_ID=
