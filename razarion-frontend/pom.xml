<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.btxtech</groupId>
    <artifactId>razarion</artifactId> <!-- Verweist auf die Parent-POM -->
    <version>1.0-SNAPSHOT</version>
  </parent>

  <artifactId>razarion-frontend</artifactId>
  <packaging>pom</packaging> <!-- Keine Java-Klasse, nur Angular-Code -->

  <name>Razarion angular frontend</name>

  <build>
    <plugins>
      <!-- Frontend-Maven-Plugin zur Verwaltung von Node.js, npm und Angular CLI -->
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>1.12.1</version>
        <executions>
          <!-- Installiert Node.js und npm -->
          <execution>
            <id>install-node-and-npm</id>
            <goals>
              <goal>install-node-and-npm</goal>
            </goals>
            <configuration>
              <nodeVersion>v20.19.3</nodeVersion>
              <npmVersion>10.8.2</npmVersion>
            </configuration>
          </execution>

          <!-- Installiert npm-Abhängigkeiten -->
          <execution>
            <id>install-dependencies</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <arguments>install</arguments>
            </configuration>
          </execution>

          <!-- Führt den Angular-Build aus -->
          <execution>
            <id>build-angular</id>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <arguments>run build</arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Empties the two destinations before the build refills them.

        copy-resources below adds and overwrites, it never deletes. Angular names its output by
        content hash, so every build writes new names rather than replacing the old ones - and
        the destinations sit under src/main/resources, which `mvn clean` does not touch, because
        clean removes target and this is a source directory. Nothing in that chain removed
        anything: measured on 8 September 2026 the directory held 2.1 GB in 2,899 files, 434 of
        them main-*.js going back to 22 July, where one build needs 59 MB.

        None of it stayed local. Maven copies src/main/resources into target/classes and Jib
        packs target/classes into the image, so those two gigabytes went to Artifact Registry on
        every deploy and came back down on every pod start. The registry stood at 133.6 GB
        across 295 images - that is this arithmetic, not a coincidence.

        excludeDefaultDirectories is not optional: without it the same run also takes this
        module's target, which at that point in the lifecycle holds the node install and the
        finished Angular output. generated/teavm-client and generated/teavm-worker are
        deliberately not in the filesets; they come from the two TeaVM modules.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <executions>
          <execution>
            <id>clear-stale-frontend-output</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>clean</goal>
            </goals>
            <configuration>
              <excludeDefaultDirectories>true</excludeDefaultDirectories>
              <filesets>
                <fileset>
                  <directory>${project.basedir}/../razarion-server/src/main/resources/generated/game</directory>
                </fileset>
                <fileset>
                  <directory>${project.basedir}/../razarion-server/src/main/resources/generated/studio</directory>
                </fileset>
              </filesets>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-angular-build</id>
            <phase>package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.basedir}/../razarion-server/src/main/resources/generated/game</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/dist/razarion-frontend/browser</directory>
                  <includes>
                    <include>**/*</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>copy-studio-build</id>
            <phase>package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.basedir}/../razarion-server/src/main/resources/generated/studio</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/dist/studio/browser</directory>
                  <includes>
                    <include>**/*</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
